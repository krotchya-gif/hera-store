# ============================================================
# HERA STORE — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your Supabase credentials
# ============================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: Supabase Service Role Key (for admin scripts only — NEVER expose to frontend)
# SUPABASE_SERVICE_KEY=your-service-role-key

# App Configuration
VITE_APP_NAME=Hera Store
VITE_APP_URL=http://localhost:5173

# Storage Bucket (if using Supabase Storage)
VITE_STORAGE_BUCKET=product-images

# Midtrans Payment Gateway (optional — for Snap integration)
# VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
# VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
